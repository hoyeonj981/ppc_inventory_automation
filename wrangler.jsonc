{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ppc-inventory-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "keep_vars": true,
  "durable_objects": {
    "bindings": [{ "name": "MESSAGE_IMPORTS", "class_name": "MessageImport" }]
  },
  "migrations": [{ "tag": "v1-message-import", "new_sqlite_classes": ["MessageImport"] }],
  "observability": {
    "enabled": true
  }
}
