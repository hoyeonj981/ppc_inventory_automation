{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ppc-inventory-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./public"
  },
  "keep_vars": true,
  "migrations": [
    {
      "tag": "v1-message-import",
      "new_sqlite_classes": [
        "MessageImport"
      ]
    },
    {
      "tag": "v2-remove-message-import",
      "deleted_classes": [
        "MessageImport"
      ]
    }
  ],
  "observability": {
    "enabled": true
  }
}